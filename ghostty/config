background-opacity = 0.90
background-blur = true

font-size = 16

# Unbind keys to pass them through to Neovim / ToggleTerm
keybind = super+n=unbind
keybind = super+8=unbind
keybind = super+9=unbind
keybind = super+digit_8=unbind
keybind = super+digit_9=unbind
keybind = super+j=unbind
keybind = super+h=unbind
keybind = super+k=unbind
keybind = super+l=unbind
# Command + Shift + [ and Command + Shift + ] are reserved by macOS for native tab
# switching (Window > Show Previous/Next Tab) and can't be unbound at the app level,
# so leave them as Ghostty's default tab switching.

# Pass Command + [ and Command + ] through to Neovim for terminal resizing
keybind = super+[=unbind
keybind = super+]=unbind

# Command + Backspace: kill whole line in shell (overrides Ghostty's default scroll-to-top).
# Sends F12's CSI code rather than a literal Ctrl-U (\x15), since tmux's root
# keytable now claims plain Ctrl-U for the scroll-freeze copy-mode trigger -
# reusing that byte here would make Cmd+Backspace scroll instead of killing
# the line. zsh/custom.zsh binds this same F12 sequence to kill-whole-line.
keybind = super+backspace=text:\x1b[24~

# Treat left Option key as Alt (Meta) for prefix-free multiplexer shortcuts
macos-option-as-alt = "left"

# Direct Alt-based bindings for Herdr tab switching (sends Ctrl+b followed by command key)
keybind = alt+1=text:\x021
keybind = alt+2=text:\x022
keybind = alt+3=text:\x023
keybind = alt+4=text:\x024
keybind = alt+5=text:\x025
keybind = alt+6=text:\x026
keybind = alt+8=text:\x02p
keybind = alt+9=text:\x02n
keybind = alt+[=text:\x02p
keybind = alt+]=text:\x02n



